# Copy to .env for local Docker runs. Never commit a real .env.
# JWT_SECRET must be Base64, decoding to at least 32 bytes:
#   openssl rand -base64 32
JWT_SECRET=
DB_PASSWORD=
# Access tokens are short-lived (15 min). Refresh tokens last 7 days.
JWT_EXPIRATION_MS=900000
REFRESH_TOKEN_EXPIRATION_MS=604800000
# Field encryption (AES-GCM, Base64, 32 bytes) — REQUIRED for real data:
#   openssl rand -base64 32
# Losing this key makes encrypted fields unreadable. Back it up securely.
ENCRYPTION_KEY=
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
CORS_ORIGINS=http://localhost
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
